# -----------------------------------------------------------------------------
# .env.example
#
# Template for the .env file consumed by docker-compose and the FastAPI backend.
# Copy to .env (in the repo root) and fill in real values. .env is gitignored
# and must never be committed. DATABASE_URL uses hostname "db" (the compose
# service name) — change to "localhost" when running the backend outside Docker.
# After editing, restart containers: `docker compose up -d` to pick up changes.
# -----------------------------------------------------------------------------

# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored — never commit secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=referrai
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=referrai

# ── FastAPI backend ──────────────────────────────────────────────────────────
# Must match POSTGRES_* above. Use the service name "db" as the hostname.
DATABASE_URL=postgresql+asyncpg://referrai:change_me_strong_password@db:5432/referrai

SECRET_KEY=change_me_to_a_random_32_plus_char_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Business thresholds (commission %, fraud/churn alerts, withdrawal limits)
# live in the `settings` table — edit them in Admin > Settings, not here.

# development | production | test  (production refuses the default SECRET_KEY)
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
# Where trained model files are stored. Leave empty for backend/models;
# docker-compose sets /models (a named volume).
# AI_MODEL_DIR=
ENABLE_SCHEDULER=true

# Optional dev/demo admin created on startup. Admins can also be created with:
#   python -m scripts.create_admin --email ... --password ...
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
