# -----------------------------------------------------------------------------
# backend/.env.example
#
# Template for running the FastAPI backend locally without Docker. Copy to
# backend/.env and adjust values. The key difference from the root .env.example
# is the DATABASE_URL hostname: "localhost" here vs "db" (compose service name)
# in the root .env. Pydantic Settings auto-loads backend/.env when uvicorn is
# started from the backend/ directory. Run: `uvicorn app.main:app --reload`.
# -----------------------------------------------------------------------------

# Backend env for running locally (outside Docker).
# Copy to backend/.env and adjust values.

DATABASE_URL=postgresql+asyncpg://referrai:referrai_dev_secret@localhost:5432/referrai
SECRET_KEY=dev-only-secret-key-replace-before-any-real-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRAUD_ALERT_THRESHOLD=70.0
