# -----------------------------------------------------------------------------
# backend/.env.example
#
# Template for running the FastAPI backend locally without Docker. Copy to
# backend/.env and adjust values. The key difference from the root .env.example
# is the DATABASE_URL hostname: "localhost" here vs "db" (compose service name)
# in the root .env. Pydantic Settings auto-loads backend/.env when uvicorn is
# started from the backend/ directory. Run: `uvicorn app.main:app --reload`.
# -----------------------------------------------------------------------------

# Backend env for running locally (outside Docker).
# Copy to backend/.env and adjust values.

DATABASE_URL=postgresql+asyncpg://referrai:referrai_dev_secret@localhost:5432/referrai
SECRET_KEY=dev-only-secret-key-replace-before-any-real-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Business thresholds (commission %, fraud/churn alerts, withdrawal limits)
# live in the `settings` table — edit them in Admin > Settings, not here.

# development | production | test  (production refuses the default SECRET_KEY)
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
# Where trained model files are stored. Leave empty for backend/models;
# docker-compose sets /models (a named volume).
# AI_MODEL_DIR=
ENABLE_SCHEDULER=true

# Optional dev/demo admin created on startup. Admins can also be created with:
#   python -m scripts.create_admin --email ... --password ...
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
