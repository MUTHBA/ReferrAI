# -----------------------------------------------------------------------------
# backend/.dockerignore
#
# Keeps the Docker build context lean for the backend image. Excludes Python
# bytecode caches, virtual environments, .env secrets, and local SQLite test
# databases. .env is excluded so secrets never land in a Docker image layer —
# environment variables are injected at runtime via docker-compose env_file.
# Source code is bind-mounted in development anyway so the COPY . . layer is
# only relevant for production builds.
# -----------------------------------------------------------------------------

__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/
.env
*.db
*.sqlite3
.pytest_cache/
