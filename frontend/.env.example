# API base URL used by the browser. Default "/api/v1" goes through the Vite
# dev proxy / nginx, so no CORS setup is needed.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api and /r. Docker: http://backend:8000.
# Running the backend directly on your machine: http://localhost:8000
VITE_PROXY_TARGET=http://backend:8000
