// -----------------------------------------------------------------------------
// frontend/package.json
//
// Frontend project manifest declaring React 18 + Vite 5 dependencies. "type":
// "module" enables ESM throughout. Runtime deps: React 18, react-router-dom v6
// (client-side routing), axios (API calls). Dev deps: Vite 5, @vitejs/plugin-react,
// ESLint with react-hooks and react-refresh rules for a clean HMR dev experience.
// Run `npm install` from frontend/ to install, then `npm run dev` to start the
// Vite server. Update version pins here when upgrading the frontend toolchain.
// -----------------------------------------------------------------------------
{
  "name": "referrai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "vite": "^5.3.1"
  }
}
